# Settings and secrets of the instructor scripts, in ONE file. Copy to config.env and fill it; config.env is never committed.
# Plain KEY=value lines (the file is sourced by bash: no spaces around =).

# secrets (instructor.txt says where each one comes from)
JUPYTER_TOKEN=change-me-16-or-more-random-characters   # the Devlab password: openssl rand -hex 16
NEBIUS_API_KEY=your-token-factory-key                   # https://tokenfactory.nebius.com
TAVILY_API_KEY=tvly-your-tavily-key                     # https://app.tavily.com

# settings
PROJECT_ID=project-xxxxxxxxxxxxxxxxxxxxxx               # the Nebius project (default: the project of the active nebius profile)
REGION=eu-west2

# Everything else has a default inside the scripts (machine sizes, names, image family, repo ...): to change one, add it here
# (variable names: the lines starting with  : "${NAME:=default}"  at the top of 1-build-image.sh and 2a-create-devlab-cli.sh).
