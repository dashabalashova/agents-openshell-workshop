# Copy to config.env and fill in (never commit). Other settings have defaults at the top of the scripts.
JUPYTER_TOKEN=change-me-16-or-more-characters   # Devlab password: openssl rand -hex 16
NEBIUS_API_KEY=your-token-factory-key           # https://tokenfactory.nebius.com
TAVILY_API_KEY=tvly-your-tavily-key             # https://app.tavily.com
PROJECT_ID=project-xxxxxxxxxxxxxxxxxxxxxx       # nebius config get parent-id
REGION=eu-west2
